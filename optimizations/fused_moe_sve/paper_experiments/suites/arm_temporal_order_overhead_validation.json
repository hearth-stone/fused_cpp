{
  "schema_version": 1,
  "id": "arm_temporal_order_overhead_validation",
  "description": "Arm-codex 80-core 1T overhead calibration and temporal-order holdout validation.",
  "machine_ids": ["arm_codex_internal_temporal_overhead"],
  "setup": [
    {
      "id": "build_extension",
      "use_affinity": false,
      "timeout_seconds": 1800,
      "argv": ["env", "FUSED_CPP_BUILD_MOE_ONLY=1", "FUSED_CPP_SVE_VECTOR_BITS={sve_bits}", "MAX_JOBS={max_jobs}", "{python}", "setup.py", "build_ext", "--inplace", "--force"]
    },
    {
      "id": "focused_correctness",
      "timeout_seconds": 1200,
      "argv": ["{python}", "-m", "pytest", "-q", "tests/test_moe_mixed_width_victim_pressure.py", "tests/test_moe_executable_plan_neighborhood.py", "tests/test_moe_analytic_model.py", "tests/test_moe_plan_v2.py", "-k", "width_specific or width_overhead or mixed_width or executable_plan or placed_dag or plan_v2_strict", "--maxfail=1"]
    }
  ],
  "cases": [
    {
      "id": "mixed_width_victim_calibration",
      "timeout_seconds": 1200,
      "output_json": true,
      "argv": ["{python}", "optimizations/fused_moe_sve/benchmarks/bench_mixed_width_victim_pressure.py", "--analytic-calibration", "{base_analytic_calibration}", "--hidden", "4096", "--intermediate", "512", "--threads", "80", "--victim-core", "77", "--peer-width", "16", "--warmup", "5", "--runs", "31", "--weight-copies", "4", "--output", "{remote_output}"]
    },
    {
      "id": "uniformish_temporal_holdout",
      "timeout_seconds": 2400,
      "output_json": true,
      "argv": ["{python}", "optimizations/fused_moe_sve/benchmarks/bench_executable_neighborhood_audit.py", "--route-file", "{uniformish_route}", "--route-layer", "{uniformish_layer}", "--analytic-calibration", "{analytic_calibration}", "--hidden", "4096", "--intermediate", "512", "--experts", "256", "--threads", "80", "--critical-experts", "32", "--neighbors-per-operator", "64", "--event-top-per-strategy", "4", "--minimum-actionable-gain-pct", "2", "--measure-hardware", "--warmup", "5", "--runs", "31", "--weight-copies", "4", "--output", "{remote_output}"]
    },
    {
      "id": "median_temporal_holdout",
      "timeout_seconds": 2400,
      "output_json": true,
      "argv": ["{python}", "optimizations/fused_moe_sve/benchmarks/bench_executable_neighborhood_audit.py", "--route-file", "{median_route}", "--route-layer", "{median_layer}", "--analytic-calibration", "{analytic_calibration}", "--hidden", "4096", "--intermediate", "512", "--experts", "256", "--threads", "80", "--critical-experts", "32", "--neighbors-per-operator", "64", "--event-top-per-strategy", "4", "--minimum-actionable-gain-pct", "2", "--measure-hardware", "--warmup", "5", "--runs", "31", "--weight-copies", "4", "--output", "{remote_output}"]
    },
    {
      "id": "high_skew_temporal_holdout",
      "timeout_seconds": 2400,
      "output_json": true,
      "argv": ["{python}", "optimizations/fused_moe_sve/benchmarks/bench_executable_neighborhood_audit.py", "--route-file", "{high_skew_route}", "--route-layer", "{high_skew_layer}", "--analytic-calibration", "{analytic_calibration}", "--hidden", "4096", "--intermediate", "512", "--experts", "256", "--threads", "80", "--critical-experts", "32", "--neighbors-per-operator", "64", "--event-top-per-strategy", "4", "--minimum-actionable-gain-pct", "2", "--measure-hardware", "--warmup", "5", "--runs", "31", "--weight-copies", "4", "--output", "{remote_output}"]
    }
  ]
}
